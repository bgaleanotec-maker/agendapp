# AgendApp — Variables de entorno
# Copia este archivo como .env y completa los valores reales

# Flask
FLASK_ENV=development
SECRET_KEY=cambia-esto-por-un-valor-secreto-seguro

# Base de datos
# Desarrollo: SQLite (por defecto)
# DATABASE_URL=sqlite:///agendapp.db
# Producción (Render PostgreSQL):
# DATABASE_URL=postgresql://user:pass@host:5432/agendapp

# Email SMTP (Gmail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=tu_app_password_gmail
MAIL_DEFAULT_SENDER=AgendApp <noreply@agendapp.co>

# WhatsApp — Twilio
# Obtener en: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número WhatsApp Business (formato: whatsapp:+57XXXXXXXXXX)
WHATSAPP_FROM=whatsapp:+573190000000

# Configuración de citas
REMINDER_HOURS_BEFORE=24
CANCELLATION_HOURS_BEFORE=24
